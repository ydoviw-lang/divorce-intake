# Supabase project settings (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password you'll use to log into /dashboard. Pick something strong.
ADMIN_PASSWORD=change-this-before-deploying

# Used to encrypt Social Security Numbers before they're stored. Must be
# a 64-character hex string. Claude generated one for you — see the README.
SSN_ENCRYPTION_KEY=

# Stripe (Dashboard -> Developers -> API keys, and Developers -> Webhooks)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price charged per case, in CENTS (e.g. 60000 = $600.00)
SERVICE_PRICE_CENTS=
